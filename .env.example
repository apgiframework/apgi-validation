# APGI Framework Environment Variables
# ====================================
# Copy this file to .env and customise for your environment:
#     cp .env.example .env
#
# EVERY variable listed here is read by the code. This file previously
# advertised 55 variables (database, AWS, Azure, SSL, worker counts, cache
# sizes) of which 52 were never read by any module — configuring them did
# nothing. If you add a variable here, wire it up; if you remove the code that
# reads one, remove it here too. tests/test_env_example_is_accurate.py enforces
# this both ways.


# ---------------------------------------------------------------------------
# Secrets — REQUIRED
# ---------------------------------------------------------------------------
# Master key that encrypts all other key material in .keys/. Generate with:
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes existing .keys/*.enc files unrecoverable; the key
# manager will refuse to start rather than silently minting replacements.
APGI_MASTER_KEY=

# Development and CI only. When APGI_MASTER_KEY is unset, allows an ephemeral
# master key to be generated per process. Never enable in production.
APGI_ALLOW_EPHEMERAL_MASTER_KEY=0

# Optional 64-character hex overrides. When unset, each key is loaded from (or
# minted into) its own encrypted file under .keys/. Values that are not exactly
# 64 hex characters are rejected and ignored.
# PICKLE_SECRET_KEY=
# APGI_BACKUP_HMAC_KEY=
# APGI_JWT_SECRET=


# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Require a --token to launch any GUI. Defaults to 0 (dev mode).
# Set to 1 for production to enforce authentication.
# In dev mode (0), a 24-hour researcher token is auto-generated.
APGI_ENFORCE_AUTH=0


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Minimum level: DEBUG, INFO, WARNING, ERROR, CRITICAL. Overridden per-run by
# the CLI's --log-level flag.
APGI_LOG_LEVEL=INFO

# Enable rotating JSON file logging. When unset, logs go to stdout only.
# Required for `apgi-cli logs --export` to have anything to export.
# APGI_LOG_FILE=logs/apgi.log

# Rotation settings, used only when APGI_LOG_FILE is set.
# APGI_LOG_MAX_SIZE=10MB
# APGI_LOG_BACKUP_COUNT=5


# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# Deployment environment label: development, staging, production.
APGI_ENV=development

# Enables production-mode assertions and stricter defaults.
APGI_PRODUCTION_MODE=0

# Reduces sampling and iteration counts so protocols finish quickly. Set
# automatically by the GUIs when running scripts.
APGI_TEST_MODE=0

# Path to an alternative config file. Defaults to config/apgi_config.yaml.
# APGI_CONFIG_PATH=config/apgi_config.yaml


# ---------------------------------------------------------------------------
# Protocol execution tuning
# ---------------------------------------------------------------------------
# Force the pure-NumPy MCMC sampler instead of PyMC. Useful where PyMC's
# compiler toolchain is unavailable.
APGI_FORCE_NUMPY_MCMC=0

# Gelman-Rubin convergence threshold for MCMC-based protocols.
APGI_RHAT_THRESHOLD=1.01

# Extra flags forwarded to PyTensor (PyMC's backend).
# PYTENSOR_FLAGS=cxx=

# Skip the protocol output manifest integrity check.
APGI_SKIP_MANIFEST_CHECK=0


# ---------------------------------------------------------------------------
# Supply chain
# ---------------------------------------------------------------------------
# Require SBOM signatures during dependency scanning.
APGI_REQUIRE_SBOM_SIGNING=0
# APGI_SBOM_SIGNING_KEY=


# ---------------------------------------------------------------------------
# GUI
# ---------------------------------------------------------------------------
# Maximum lines retained in GUI output panes.
APGI_GUI_BUFFER_SIZE=10000

# Testing only: prevents tests/conftest.py from replacing tkinter with a mock,
# so GUI smoke tests instantiate real widgets. Requires a display (xvfb on CI).
APGI_REAL_TKINTER=0

# --- APGI System API ---------------------------------------------------------
# All APGI applications talk to the hosted API. Override only for staging or a
# local `uvicorn app.main:app` (plain http is accepted for loopback hosts only).
# APGI_API_URL=https://api.apgiframework.com
# APGI_API_TOKEN=
# APGI_API_TIMEOUT=15
