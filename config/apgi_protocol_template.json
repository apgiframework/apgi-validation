{
  "apgi_validation_metadata": {
    "version": "3.0",
    "last_updated": "2026-05-22",
    "schema_notes": "Ground truth: APGI_Protocols_Enhanced.docx (6_APGI_Protocols). Benchmarks use typed objects with value + unit + role fields. Falsification thresholds are directional bounds. Primary vs. behavioral_tier markers establish hierarchy for multi-operationalisation predictions. All numeric thresholds match protocol narrative exactly; no values invented beyond what the protocol document specifies.",

    "protocols": {

      "P01": {
        "id": "EEG_Interoceptive_Precision_Gating",
        "vp_mapping": "VP-8",
        "status": "pending_data_collection",
        "sample_size": {
          "n_participants": 36,
          "range": [32, 40],
          "design": "within_subject_3x2",
          "power_analysis": "within_subjects_ANOVA_3_conditions_alpha_0.05_power_0.80_r_0.5_Bonferroni"
        },
        "design": {
          "type": "factorial_3x2_counterbalanced",
          "conditions": [
            { "id": "interoceptive_focus", "description": "attend_heartbeat_while_detecting_visual_stimuli_pulse_oximetry_sync" },
            { "id": "exteroceptive_focus", "description": "attend_visual_clarity_matched_attentional_load" },
            { "id": "dual_task_control", "description": "count_tones_while_detecting_visual_stimuli_attention_division" }
          ],
          "stimuli": "Gabor_50pct_threshold_individually_calibrated_adaptive_staircase"
        },
        "dependent_variables": [
          {
            "name": "VAN",
            "window_ms": [150, 250],
            "theoretical_role": "pre_conscious_precision_signature",
            "dissociation_target": "Recurrent_Processing_Theory_which_relies_on_VAN_as_primary_criterion"
          },
          {
            "name": "P3b",
            "window_ms": [300, 600],
            "theoretical_role": "ignition_index_primary_DV"
          },
          {
            "name": "HEP",
            "window_ms": [250, 400],
            "reference": "post_R_wave",
            "theoretical_role": "interoceptive_precision_proxy_Pi_i"
          },
          {
            "name": "baseline_interoceptive_accuracy",
            "measure": "heartbeat_detection_task",
            "reference": "Garfinkel_et_al_2014"
          }
        ],
        "benchmarks": {
          "P1a_P3b_amplitude_shift": {
            "value": [2.0, 3.0],
            "unit": "microvolts",
            "role": "primary_confirming",
            "minimum_confirming_uV": 1.0,
            "note": "Values below 1.0 uV are non-confirming even if p < 0.05 — prevents trivially small effects inflating validation score"
          },
          "P1a_cohens_d": {
            "value": [0.5, 0.7],
            "unit": "cohens_d",
            "minimum_confirming_d": 0.2,
            "reference": "Sel_et_al_2017_d_0.63",
            "role": "primary_confirming"
          },
          "P1b_HEP_P3b_correlation": {
            "value": 0.4,
            "operator": "greater_than",
            "unit": "pearson_r",
            "covariate_control": "pupil_diameter",
            "role": "primary_confirming",
            "note": "HEP must predict P3b change beyond general arousal with pupil diameter controlled"
          },
          "P1c_trait_interaction": {
            "eta_squared": [0.08, 0.12],
            "unit": "eta_squared",
            "operationalisation": "categorical_ANOVA_top_tertile_interoceptive_accuracy_x_condition",
            "factor_structure": "accuracy_tertile_between_subjects_x_condition_within_subjects",
            "note": "NOT reducible to HRV covariate control — requires tertile x condition interaction term; covariate test only shows effect is not caused by HRV, does not test that trait sensitivity scales the threshold",
            "role": "primary_confirming"
          }
        },
        "control_analyses": {
          "arousal_confounds": ["pupil_diameter_covariate", "alpha_power_covariate"],
          "attention_confounds": "performance_on_attention_check_trials",
          "individual_differences": "random_slopes_for_participants_in_mixed_effects_model"
        },
        "falsification_thresholds": {
          "HEP_P3b_r_below": 0.2,
          "P3b_delta_uV_below": 1.0,
          "cohens_d_below": 0.2,
          "P3b_uniform_across_conditions_p_above": 0.1,
          "exteroceptive_P3b_geq_interoceptive": true
        }
      },

      "P02": {
