          "threat_reward_tradeoffs_high_reward_aversive_interoceptive_consequences"
        ],
        "volatility_schedule": [0.1, 0.3, 0.6, 0.3, 0.1],
        "comparison_null_models": {
          "GNWT_only": {
            "description": "ignition_without_somatic_markers_or_precision_weighting",
            "expected_convergence_trials": { "value": [100, 120], "unit": "trials" }
          },
          "Pure_PP": {
            "description": "no_global_ignition_layer_continuous_processing",
            "expected_convergence_trials": { "value": 150, "operator": "greater_than", "unit": "trials" }
          }
        },
        "benchmarks": {
          "P3a_APGI_convergence_trials": {
            "value": [50, 80],
            "unit": "trials",
            "human_benchmark": "Bechara_1997_IGT_60_80_trials",
            "reward_advantage_pct": [15, 25],
            "note": "Temporal constraint is NON-NEGOTIABLE for Functional Isomorphism — reward ratio alone (e.g. >1.15 at p<0.05) is insufficient; APGI must reach criterion within the human performance window",
            "role": "primary_confirming"
          },
          "P3b_interoceptive_trigger_composition": {
            "value": [0.70, 0.85],
            "unit": "proportion_of_ignition_events",
            "criterion": "Pi_i_times_abs_z_i_greater_than_Pi_e_times_abs_z_e_at_ignition_event",
            "operationalisation": "triggering_condition_NOT_post_ignition_action_entropy",
            "note": "Post-ignition action entropy supports computational advantage claim but does not validate somatic suppression mechanism — only the triggering condition tests the core APGI claim",
            "role": "primary_confirming"
          },
          "P3c_strategy_shift_logistic_regression": {
            "model": "P(strategy_change) ~ ignition + |epsilon| + controls",
            "ignition_coefficient_p_value_max": 0.01,
            "requirement": "ignition_term_survives_epsilon_covariate_control",
            "note": "Pre-registered model specification — not post-hoc; bare p-value without model string is insufficient for pre-registration compliance",
            "role": "primary_confirming"
          },
          "P3d_volatility_adaptation_speedup": {
            "value": [0.20, 0.30],
            "unit": "proportion_faster_than_GNWT_only",
            "measurement": "trials_to_criterion_after_contingency_shifts_in_volatile_foraging",
            "mechanism": "somatic_markers_provide_rapid_value_updates",
            "role": "secondary_confirming"
          }
        },
        "model_comparison": {
          "primary": "Bayesian_Information_Criterion_BIC_fit_to_human_data",
          "secondary": "cross_validation_held_out_trials",
          "sensitivity": "parameter_range_analysis_alpha_beta_theta_baseline"
        },
        "falsification_thresholds": {
          "min_performance_advantage_pct": 0.05,
          "APGI_max_convergence_trials": 80,
          "interoceptive_trigger_ratio_below_falsifies": 0.60,
          "ignition_strategy_shift_p_above_falsifies": 0.30,
          "Pure_PP_outperforms_APGI_falsifies": true
        }
      },

