          "coil": "70mm_figure_eight",
          "pulse_timing": "100ms_pre_stimulus",
          "safety_protocol": "standard_TMS_screening_realtime_EEG_monitoring"
        },
        "benchmarks": {
          "P2a_dlPFC_PPC_PCI_reduction": {
            "value": [0.15, 0.25],
            "unit": "proportion",
            "specificity_control": "vertex_PCI_reduction_max_0.05",
            "null_result_required": "dlPFC_and_PPC_TMS_must_NOT_reduce_HEP",
            "role": "primary_confirming"
          },
          "P2b_aINS_PCI_reduction": {
            "value": 0.20,
            "unit": "proportion",
            "role": "primary_confirming"
          },
          "P2b_aINS_HEP_reduction": {
            "value": 0.30,
            "unit": "proportion",
            "dissociation_control": "dlPFC_TMS_must_spare_HEP_to_confirm_double_dissociation",
            "role": "primary_confirming"
          },
          "P2b_amplitude_dissociation": {
            "description": "aINS_TMS_reduces_both_PCI_and_HEP; dlPFC_TMS_reduces_PCI_only",
            "operationalisation": "amplitude_based_NOT_coupling_based",
            "role": "primary_confirming"
          },
          "P2c_baseline_accuracy_x_TMS_site_interaction": {
            "cohens_d": [0.6, 0.9],
            "unit": "cohens_d",
            "operationalisation": "Baseline_Interoceptive_Accuracy_x_TMS_Site_ANOVA_interaction_on_PCI",
            "specificity": "interaction_absent_for_dlPFC_and_PPC_sites",
            "direction": "high_Pi_i_individuals_show_larger_PCI_decrease_following_aINS_TMS",
            "role": "primary_confirming"
          }
        },
        "falsification_thresholds": {
          "PCI_sham_vertex_reduction_max": 0.05,
          "dlPFC_TMS_HEP_reduction_max": 0.10,
          "aINS_TMS_PCI_reduction_below_falsifies": 0.05,
          "aINS_TMS_PCI_without_HEP_reduction_falsifies": true,
          "uniform_PCI_reduction_all_sites_falsifies": true,
          "PPC_or_dlPFC_TMS_reduces_HEP_falsifies": true
        }
      },

      "P03": {
        "id": "Active_Inference_Agent_Simulations",
        "vp_mapping": "VP-3",
        "status": "validated",
        "sample_size": {
          "n_simulations_per_condition": 1000,
          "random_seeds": 1000,
          "pilot_trials": 10000,
          "note": "Pilot simulations confirm stable convergence within 200 trials for all agent types"
        },
        "agent_architecture": {
          "generative_models": "hierarchical_3_level_interoceptive_and_exteroceptive_separate",
          "precision_weighting": "dynamic_Pi_e_and_Pi_i_updated_online",
          "somatic_marker_learning": "M_c_a_updates_via_reward_prediction_errors",
          "global_workspace": "ignition_equation_S_t_greater_theta_t",
          "threshold_adaptation": "theta_t+1 = theta_t + eta(C_metabolic - V_information)"
        },
        "environment": "IGT_Volatile_Foraging_Homeostatic",
        "task_environments": [
          "Iowa_Gambling_Task_variant_physiological_penalties_interoceptive_costs",
